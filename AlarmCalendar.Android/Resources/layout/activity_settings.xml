<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="12dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Defaults for tasks" android:textStyle="bold" android:layout_marginBottom="4dp" />
            <com.google.android.material.card.MaterialCardView style="@style/Pane">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="10dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sound: " />
                        <Button android:id="@+id/sound" style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Hint"
                        android:text="Every task left on &quot;Default&quot; plays this, including tasks made before the change." />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Play the sound:" android:layout_marginTop="8dp" />
                    <RadioGroup android:layout_width="match_parent" android:layout_height="wrap_content">
                        <RadioButton android:id="@+id/mode_once" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="once each time an alarm appears" />
                        <RadioButton android:id="@+id/mode_repeat" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="over and over until the alarm is closed or marked done" />
                    </RadioGroup>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Volume (of the alarm volume)" android:layout_marginTop="8dp" />
                    <Spinner android:id="@+id/default_volume" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <Spinner android:id="@+id/default_fade_in" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="New tasks remind again after" android:layout_marginTop="8dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <EditText android:id="@+id/rem_hours" style="@style/NumberField" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" h " />
                        <EditText android:id="@+id/rem_minutes" style="@style/NumberField" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" min" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center_vertical" android:layout_marginTop="4dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Time of day for new days-of-the-week tasks: " />
                        <Button android:id="@+id/time_of_day" style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="For new &quot;every N&quot; tasks, the next time comes up:" android:layout_marginTop="4dp" />
                    <RadioGroup android:layout_width="match_parent" android:layout_height="wrap_content">
                        <RadioButton android:id="@+id/restart_from_done" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="N after it's marked done" />
                        <RadioButton android:id="@+id/restart_on_schedule" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="on the original schedule" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Your tasks" android:textStyle="bold" android:layout_marginVertical="4dp" />
            <com.google.android.material.card.MaterialCardView style="@style/Pane">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="10dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <Button android:id="@+id/export_tasks" style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Export tasks" />
                        <Button android:id="@+id/import_tasks" style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Import tasks"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Hint"
                        android:text="Export saves every task to a file, as a backup or to move them to a device that isn't linked. Importing a file adds the tasks it has that this phone doesn't (deleted ones included), and updates any it holds a newer version of; nothing that came up in the past rings. These act at once, without Save." />
                    <TextView android:id="@+id/transfer_text" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />
                    <CheckBox android:id="@+id/auto_backup" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:text="Back up automatically after every change" />
                    <TextView android:id="@+id/backup_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                        style="@style/Hint" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Hint"
                        android:text="To Download/Alarm Calendar backups, a few seconds after a task is added, changed or deleted, here or on a linked device (marking done doesn't count). Every backup from the last day is kept, then one a day for 60 days, then one a month for two years. To restore, import one: it brings back deleted tasks, and doesn't undo changes made since." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="So that alarms reach you" android:textStyle="bold" android:layout_marginVertical="4dp" />
            <com.google.android.material.card.MaterialCardView style="@style/Pane">
                <LinearLayout android:id="@+id/permissions" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="10dp" />
            </com.google.android.material.card.MaterialCardView>

            <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/error" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:padding="8dp">
        <Button android:id="@+id/cancel" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cancel" />
        <Button android:id="@+id/save" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Save" />
    </LinearLayout>
</LinearLayout>
