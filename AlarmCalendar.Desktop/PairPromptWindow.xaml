<Window x:Class="AlarmCalendar.Desktop.PairPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Link a device?" Icon="app.ico"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        Topmost="True" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16,12,16,14">
        <TextBlock x:Name="Question" TextWrapping="Wrap" FontSize="14" />
        <TextBlock Text="It should be showing this code:" Margin="0,12,0,2" />
        <TextBlock x:Name="CodeText" FontSize="30" FontWeight="SemiBold" FontFamily="Consolas" HorizontalAlignment="Center" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                   Text="Accept only if the codes match. Once linked, both devices share all their tasks and keep them in sync." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="_Link" Click="Accept_Click" FontWeight="SemiBold" />
            <Button Content="_Don't link" IsCancel="True" Margin="8,0,0,0" Click="Reject_Click" />
        </StackPanel>
    </StackPanel>
</Window>
