<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <!-- Android 10: typed foreground services, showing over the lock screen, notification
         channels and adaptive icons all exist from here. -->
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Not RemindMe.Android: inside that namespace, "Android.App" would resolve to
         RemindMe.Android.App rather than the platform's. -->
    <RootNamespace>RemindMe.Droid</RootNamespace>
    <AssemblyName>RemindMe.Android</AssemblyName>
    <ApplicationId>com.inhahe.remindme</ApplicationId>
    <ApplicationTitle>RemindMe</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Core serializes with source-generated System.Text.Json, so full trimming is safe;
         trim warnings are errors (TreatWarningsAsErrors), so a reflection-based call
         sneaking back in fails the Release build. -->
    <TrimMode>full</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemindMe.Core\RemindMe.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.8.0" />
    <PackageReference Include="Xamarin.AndroidX.Core" Version="1.19.1" />
    <PackageReference Include="Xamarin.AndroidX.RecyclerView" Version="1.4.0.6" />
    <PackageReference Include="Xamarin.Google.Android.Material" Version="1.14.0.6" />
  </ItemGroup>
</Project>
