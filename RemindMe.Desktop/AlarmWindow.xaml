<Window x:Class="RemindMe.Desktop.AlarmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alarm" Icon="app.ico"
        SizeToContent="Height" Width="500" MinHeight="200"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Scrolls when the screen is too short for it all (ScreenFit); what the alarm
             asks of you stays below it, in view. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,12,16,0">
                <TextBlock x:Name="Heading" Style="{StaticResource Hint}" FontSize="13" Margin="0,0,0,6" />
                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="DescriptionText" FontSize="18" TextWrapping="Wrap" />
                </ScrollViewer>
                <TextBlock x:Name="MissedText" Margin="0,6,0,0" Style="{StaticResource Hint}" />

                <Border x:Name="LatePanel" Margin="0,10,0,0" Padding="12,8" CornerRadius="6" BorderThickness="1"
                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <TextBlock x:Name="LateText" TextWrapping="Wrap" />
                </Border>
                <TextBlock x:Name="SoundProblem" Margin="0,6,0,0" Style="{StaticResource Error}" />

                <StackPanel x:Name="RestartPanel" Margin="0,12,0,0">
                    <TextBlock Text="The next time comes up:" />
                    <RadioButton x:Name="FromDoneRadio" Margin="12,4,0,0"
                                 Content="_counted from when I mark this done (the timer restarts then)" />
                    <RadioButton x:Name="OnScheduleRadio" Margin="12,2,0,0"
                                 Content="on the _original schedule, whenever I mark this done" />
                </StackPanel>

                <TextBlock Text="If I close this without marking it done, remind me again after:" Margin="0,12,0,0"
                           TextWrapping="Wrap" />
                <WrapPanel Margin="0,4,0,0">
                    <TextBox x:Name="ReminderHours" Style="{StaticResource Small}" />
                    <TextBlock Text=" h " VerticalAlignment="Center" />
                    <TextBox x:Name="ReminderMinutes" Style="{StaticResource Small}" />
                    <TextBlock Text=" min" VerticalAlignment="Center" />
                </WrapPanel>
                <TextBlock Style="{StaticResource Hint}" Text="0 h 0 min: no more reminders until the next time it comes up." Margin="0,2,0,0" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Margin="16,0,16,14">
            <TextBlock x:Name="ErrorText" Style="{StaticResource Error}" Margin="0,4,0,0" />
            <WrapPanel x:Name="SnoozePanel" Margin="0,10,0,0">
                <TextBlock Text="Remind me in:" VerticalAlignment="Center" Margin="0,0,6,0" />
            </WrapPanel>
            <DockPanel Margin="0,14,0,0" LastChildFill="False">
                <Button x:Name="SilenceButton" DockPanel.Dock="Left" Content="_Silence" Click="Silence_Click"
                        ToolTip="Stop the sound but keep this window open" />
                <Button DockPanel.Dock="Right" Content="_Mark done" Click="Done_Click" Margin="8,0,0,0" Style="{StaticResource Primary}" />
                <Button DockPanel.Dock="Right" Content="_Close, remind me later" IsCancel="True" Click="Dismiss_Click" />
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
