<Application x:Class="RemindMe.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- A pane in a rounded rectangle: the outer panes of the task editor (R3). -->
        <Style x:Key="Pane" TargetType="Border">
            <Setter Property="BorderBrush" Value="#FF9AA5B1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,6,10,10" />
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="Background" Value="#FFF7F9FB" />
        </Style>
        <!-- A pane nested inside another (R4). -->
        <Style x:Key="NestedPane" TargetType="Border" BasedOn="{StaticResource Pane}">
            <Setter Property="BorderBrush" Value="#FFB8C2CC" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Margin" Value="0,2,0,6" />
        </Style>
        <!-- Greys out a pane's contents when its radio button isn't chosen. -->
        <Style x:Key="PaneBody" TargetType="FrameworkElement">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PaneRadio" TargetType="RadioButton">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="MinWidth" Value="80" />
        </Style>
        <Style x:Key="Small" TargetType="TextBox">
            <Setter Property="Width" Value="44" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF5F6B76" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Application.Resources>
</Application>
