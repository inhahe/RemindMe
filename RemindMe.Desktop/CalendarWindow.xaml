<Window x:Class="RemindMe.Desktop.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RemindMe.Desktop"
        Title="Calendar" Icon="app.ico"
        Width="1080" Height="700" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True">
    <Window.Resources>
        <!-- A day in the grid: a card, shaded under the mouse. A button, so the keyboard
             reaches it: Tab enters the grid at the chosen day (the only one that is a tab
             stop), and the arrow keys move between days (MonthGrid_PreviewKeyDown). -->
        <Style x:Key="DayCell" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The chosen day: outlined in the accent colour, its contents where they were. -->
        <Style x:Key="ChosenDayCell" TargetType="Button" BasedOn="{StaticResource DayCell}">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="5,3" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
            <!-- The arrow buttons stretch to Today's height: the icon font's lines are shorter
                 than text's, and the theme centres buttons. -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="Prev_Click" MinWidth="0" VerticalAlignment="Stretch"
                        ToolTip="Previous month" AutomationProperties.Name="Previous month">
                    <TextBlock Style="{StaticResource Icon}" Text="{x:Static local:Icons.Previous}" FontSize="12" />
                </Button>
                <TextBlock x:Name="MonthTitle" FontSize="18" FontWeight="SemiBold" Margin="12,0" MinWidth="200"
                           TextAlignment="Center" VerticalAlignment="Center" />
                <Button Click="Next_Click" MinWidth="0" VerticalAlignment="Stretch"
                        ToolTip="Next month" AutomationProperties.Name="Next month">
                    <TextBlock Style="{StaticResource Icon}" Text="{x:Static local:Icons.Next}" FontSize="12" />
                </Button>
                <Button Content="_Today" Click="Today_Click" MinWidth="0" Margin="12,0,0,0" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center"
                       Text="Red: came up, not marked done yet. ~: an estimate, for a task that restarts when marked done. Paused tasks aren't shown." />
        </DockPanel>
        <!-- The month, then the chosen day: their order is the order Tab takes. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="MonthGrid" PreviewKeyDown="MonthGrid_PreviewKeyDown" />
            <Border Grid.Column="1" Width="320" Margin="10,0,0,0" Style="{StaticResource Pane}">
                <DockPanel>
                    <TextBlock x:Name="DayTitle" DockPanel.Dock="Top" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Double-click a task, or press Enter, to edit it." />
                    <ListBox x:Name="DayList" Margin="0,8,0,0" BorderThickness="0" Background="Transparent"
                             MouseDoubleClick="DayList_DoubleClick" KeyDown="DayList_KeyDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
