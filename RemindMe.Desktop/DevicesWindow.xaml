<Window x:Class="RemindMe.Desktop.DevicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Devices and sync" Icon="app.ico"
        Width="640" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Scrolls when the screen is too short for it all (ScreenFit); the error and the
             buttons stay below it, in view. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14,10,14,4">
                <CheckBox x:Name="SyncEnabled" Content="_Sync tasks with my other devices" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="20,2,0,8" />

                <TextBlock Text="Devices" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Pane}" Padding="2,4" Margin="0,0,0,0">
                    <ListView x:Name="DeviceList" Height="170" SelectionMode="Single" BorderThickness="0"
                              Background="Transparent" SelectionChanged="DeviceList_SelectionChanged">
                        <!-- A screen reader names a row by its device, not by its record's text. -->
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem"
                                   BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="170" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Status" Width="250" DisplayMemberBinding="{Binding Status}" />
                                <GridViewColumn Header="Address" Width="150" DisplayMemberBinding="{Binding Address}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
                <DockPanel Margin="0,8,0,0" LastChildFill="True">
                    <Button x:Name="LinkButton" DockPanel.Dock="Left" Content="_Link…" Click="Link_Click" IsEnabled="False"
                            ToolTip="Join the selected device's sync group: both then share all their tasks" />
                    <TextBlock x:Name="PairStatus" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,8"
                           Text="Devices on this network appear by themselves. To link one, select it and click Link: both devices then show a code. Check that the codes match, then accept on both." />

                <Border Style="{StaticResource Pane}">
                    <StackPanel>
                        <WrapPanel>
                            <Label Content="This device's _name: " Target="{Binding ElementName=DeviceName}" Padding="0" VerticalAlignment="Center" />
                            <TextBox x:Name="DeviceName" Width="220" VerticalContentAlignment="Center" />
                        </WrapPanel>
                        <TextBlock Text="Devices elsewhere (over the internet), one per line, as host or host:port:" Margin="0,8,0,2" />
                        <TextBox x:Name="RemoteAddresses" AcceptsReturn="True" Height="54" VerticalScrollBarVisibility="Auto" />
                        <CheckBox x:Name="AcceptExternal" Margin="0,8,0,0"
                                  Content="Accept connections from outside the local network" />
                        <TextBlock Style="{StaticResource Hint}" Margin="20,2,0,0"
                                   Text="Needed on the device the others dial over the internet (with the port forwarded to it). Only linked devices can read or change tasks." />
                        <WrapPanel Margin="0,8,0,0">
                            <Label Content="_Port: " Target="{Binding ElementName=Port}" Padding="0" VerticalAlignment="Center" />
                            <TextBox x:Name="Port" Style="{StaticResource Small}" Width="70" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="1" x:Name="ErrorText" Style="{StaticResource Error}" Margin="14,8,14,0" />
        <DockPanel Grid.Row="2" Margin="14,6,14,12" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Lea_ve the sync group…" Click="Leave_Click"
                    ToolTip="This device keeps its tasks but stops syncing with the others" />
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" Margin="8,0,0,0" Click="Close_Click" />
            <Button DockPanel.Dock="Right" Content="_Apply" Click="Apply_Click" Style="{StaticResource Primary}" />
        </DockPanel>
    </Grid>
</Window>
