<Window x:Class="RemindMe.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RemindMe.Desktop"
        Title="RemindMe" Icon="app.ico"
        Width="1080" Height="540" MinWidth="560" MinHeight="260"
        PreviewTextInput="Window_PreviewTextInput">
    <Window.Resources>
        <!-- BasedOn the theme's row for a GridView: the plain list item has no columns. -->
        <Style x:Key="RowStyle" TargetType="ListViewItem"
               BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <!-- A screen reader says the task, then its status, which the row otherwise shows
                 only by its colours; bound, so it is told as they change. -->
            <Setter Property="AutomationProperties.Name" Value="{Binding Description}" />
            <Setter Property="AutomationProperties.ItemStatus" Value="{Binding Status}" />
            <EventSetter Event="MouseDoubleClick" Handler="Row_DoubleClick" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Ringing}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Waiting}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Finished}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Paused}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Setter Property="FontStyle" Value="Italic" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The tray icon's menu: a WPF menu, so that it takes the theme like the windows.
             Not shared: each opening makes a new one, with the theme as it is then, as a
             closed menu outside every window misses a switch between light and dark. -->
        <ContextMenu x:Key="TrayMenu" x:Shared="False" Placement="MousePoint">
            <MenuItem Header="_Show RemindMe" Click="TrayShow_Click" FontWeight="SemiBold" />
            <Separator />
            <MenuItem Header="_New task…" Click="New_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static local:Icons.New}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Ca_lendar…" Click="Calendar_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static local:Icons.Calendar}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="De_vices and sync…" Click="Devices_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static local:Icons.Devices}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="_Settings…" Click="Settings_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static local:Icons.Settings}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="E_xit" Click="Exit_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static local:Icons.Exit}" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <!-- The toolbar. Too narrow for its buttons, it puts the last ones in a menu under a
             More button, which shows only then; it keeps its room while hidden, or showing
             it would take room from a button, changing what fits. The theme's template has a
             grip for moving the toolbar, and a faint chevron for the menu, easily missed. -->
        <Style x:Key="Bar" TargetType="ToolBar" BasedOn="{StaticResource {x:Type ToolBar}}">
            <!-- Tab goes on past the toolbar, which by default keeps it cycling inside. -->
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolBar">
                        <DockPanel>
                            <ToggleButton x:Name="More" DockPanel.Dock="Right" ClickMode="Press"
                                          ToolTip="More" AutomationProperties.Name="More"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          IsChecked="{Binding IsOverflowOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Back" Background="Transparent" CornerRadius="4" Padding="9,6">
                                            <TextBlock Style="{StaticResource Icon}" Text="{x:Static local:Icons.More}" FontSize="16" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{Binding IsOverflowOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   PlacementTarget="{Binding ElementName=More}" Placement="Bottom" StaysOpen="False"
                                   AllowsTransparency="True" PopupAnimation="Slide" Focusable="False">
                                <Border Background="{DynamicResource SystemFillColorSolidNeutralBackgroundBrush}"
                                        BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="4" Margin="0,4,0,0">
                                    <!-- One button a row. -->
                                    <ToolBarOverflowPanel x:Name="PART_ToolBarOverflowPanel" WrapWidth="1" Focusable="True"
                                                          FocusVisualStyle="{x:Null}" KeyboardNavigation.TabNavigation="Cycle"
                                                          KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                            <ToolBarPanel x:Name="PART_ToolBarPanel" IsItemsHost="True" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasOverflowItems" Value="False">
                                <Setter TargetName="More" Property="Visibility" Value="Hidden" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- The toolbar, an icon beside each label. The buttons on the right are docked
             first, so a narrow window moves the toolbar's last buttons into its More menu,
             not these. -->
        <Border DockPanel.Dock="Top" Padding="8,8" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Click="Devices_Click"
                            ToolTip="Sync with your other computers and phone"
                            local:Icons.Glyph="{x:Static local:Icons.Devices}" Content="De_vices…" />
                    <Button Style="{StaticResource ToolButton}" Click="Calendar_Click"
                            ToolTip="A month of your tasks"
                            local:Icons.Glyph="{x:Static local:Icons.Calendar}" Content="Ca_lendar…" />
                    <Button Style="{StaticResource ToolButton}" Click="Settings_Click"
                            local:Icons.Glyph="{x:Static local:Icons.Settings}" Content="_Settings…" />
                    <Button Style="{StaticResource ToolButton}" Click="Exit_Click" Margin="0"
                            ToolTip="Quit RemindMe: alarms don't ring until it runs again"
                            local:Icons.Glyph="{x:Static local:Icons.Exit}" Content="E_xit" />
                </StackPanel>
                <ToolBar x:Name="MainBar" Style="{StaticResource Bar}">
                    <Button Style="{StaticResource Primary}" ContentTemplate="{StaticResource WithIcon}"
                            Click="New_Click" Margin="0,0,10,0" MinWidth="0" ToolBar.OverflowMode="Never"
                            local:Icons.Glyph="{x:Static local:Icons.New}" Content="_New task…" />
                    <Button Style="{StaticResource ToolButton}" x:Name="EditButton" Click="Edit_Click"
                            local:Icons.Glyph="{x:Static local:Icons.Edit}" Content="_Edit…" />
                    <Button Style="{StaticResource ToolButton}" x:Name="DoneButton" Click="Done_Click"
                            local:Icons.Glyph="{x:Static local:Icons.Done}" Content="_Mark done" />
                    <Button Style="{StaticResource ToolButton}" x:Name="ShowAlarmButton" Click="ShowAlarm_Click"
                            local:Icons.Glyph="{x:Static local:Icons.ShowAlarm}" Content="Show _alarm" />
                    <Button Style="{StaticResource ToolButton}" x:Name="PauseButton" Click="PauseResume_Click"
                            ToolTip="A paused task doesn't ring until it is resumed; a paused countdown keeps the time it has left"
                            local:Icons.Glyph="{x:Static local:Icons.Pause}" Content="_Pause" />
                    <Button Style="{StaticResource ToolButton}" x:Name="DeleteButton" Click="Delete_Click"
                            local:Icons.Glyph="{x:Static local:Icons.Delete}" Content="_Delete" />
                </ToolBar>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="14,6" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" />
        </Border>
        <Grid>
            <ListView x:Name="List" ItemContainerStyle="{StaticResource RowStyle}" SelectionMode="Extended"
                      SelectionChanged="List_SelectionChanged" KeyDown="List_KeyDown" BorderThickness="0">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="_Edit…" Click="Edit_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static local:Icons.Edit}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="_Mark done" Click="Done_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static local:Icons.Done}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Show _alarm" Click="ShowAlarm_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static local:Icons.ShowAlarm}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="PauseMenuItem" Header="_Pause" Click="PauseResume_Click">
                            <MenuItem.Icon><TextBlock x:Name="PauseMenuIcon" Style="{StaticResource Icon}" Text="{x:Static local:Icons.Pause}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="_Restart countdown" Click="RestartCountdown_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static local:Icons.Restart}" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="_Delete" Click="Delete_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static local:Icons.Delete}" /></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Description" Width="250">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Schedule" Width="250">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Schedule}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Schedule}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Status" Width="270">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Next" Width="170" DisplayMemberBinding="{Binding Next}" />
                    </GridView>
                </ListView.View>
            </ListView>
            <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextAlignment="Center" FontSize="14"
                       Text="No tasks yet.&#x0a;Click &quot;New task…&quot; to add one." />
        </Grid>
    </DockPanel>
</Window>
