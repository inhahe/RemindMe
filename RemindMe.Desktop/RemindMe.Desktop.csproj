<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon (the tray icon) comes from WinForms. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>RemindMe.Desktop</RootNamespace>
    <AssemblyName>RemindMe</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>RemindMe</Product>
    <Version>0.1.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms' implicit usings clash with WPF's (Application, MessageBox, ...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemindMe.Core\RemindMe.Core.csproj" />
  </ItemGroup>

</Project>
