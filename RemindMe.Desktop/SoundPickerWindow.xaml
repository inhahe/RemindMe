<Window x:Class="RemindMe.Desktop.SoundPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RemindMe.Desktop"
        Title="Choose a sound" Icon="app.ico"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <RadioButton x:Name="DefaultRadio" GroupName="Src" Style="{StaticResource PaneRadio}" />
        <TextBlock x:Name="DefaultHint" Style="{StaticResource Hint}" Margin="20,0,0,8"
                   Text="Follows the default sound in Settings, including later changes to it." />

        <RadioButton x:Name="SystemRadio" GroupName="Src" Style="{StaticResource PaneRadio}" Content="A _Windows sound:" />
        <ComboBox x:Name="SystemList" Margin="20,0,0,8" DisplayMemberPath="Name" />

        <RadioButton x:Name="FileRadio" GroupName="Src" Style="{StaticResource PaneRadio}" Content="A sound _file:" />
        <DockPanel Margin="20,0,0,4">
            <Button DockPanel.Dock="Right" Content="_Browse…" Margin="6,0,0,0" Click="Browse_Click" />
            <TextBox x:Name="FilePath" IsReadOnly="True" VerticalContentAlignment="Center" />
        </DockPanel>

        <DockPanel Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Click="Preview_Click" ContentTemplate="{StaticResource WithIcon}"
                    local:Icons.Glyph="{x:Static local:Icons.Play}" Content="_Play" />
            <Button DockPanel.Dock="Left" Margin="6,0,0,0" Click="Stop_Click" ContentTemplate="{StaticResource WithIcon}"
                    local:Icons.Glyph="{x:Static local:Icons.Stop}" Content="S_top" />
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Margin="8,0,0,0" Click="Cancel_Click" />
            <Button DockPanel.Dock="Right" Content="_OK" Click="Ok_Click" Style="{StaticResource Primary}" />
        </DockPanel>
    </StackPanel>
</Window>
