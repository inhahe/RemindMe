<Window x:Class="RemindMe.Desktop.TaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New task" Icon="app.ico"
        Width="680" SizeToContent="Height" MinWidth="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14,10,14,4">
                <Label Content="_Description" Target="{Binding ElementName=Description}" Padding="0,0,0,3" />
                <!-- AcceptsReturn: Enter adds a line; only the Save button saves (R2). -->
                <TextBox x:Name="Description" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="72" MaxHeight="200" VerticalScrollBarVisibility="Auto"
                         SpellCheck.IsEnabled="True" />

                <!-- R3: Scheduled vs Countdown, each with its own rounded pane. -->
                <RadioButton x:Name="ScheduledRadio" GroupName="Top" Style="{StaticResource PaneRadio}"
                             Content="_Scheduled" Margin="0,12,0,3" />
                <Border Style="{StaticResource Pane}">
                    <StackPanel Style="{StaticResource PaneBody}"
                                IsEnabled="{Binding IsChecked, ElementName=ScheduledRadio}">

                        <!-- R4: the nested choice, each option with a nested rounded pane. -->
                        <RadioButton x:Name="IntervalRadio" GroupName="Schedule" Style="{StaticResource PaneRadio}"
                                     Content="_Every N years, months, weeks, days, hours, minutes or seconds" />
                        <Border Style="{StaticResource NestedPane}">
                            <StackPanel Style="{StaticResource PaneBody}"
                                        IsEnabled="{Binding IsChecked, ElementName=IntervalRadio}">
                                <WrapPanel>
                                    <TextBlock Text="Every " VerticalAlignment="Center" />
                                    <TextBox x:Name="IntervalCount" Style="{StaticResource Small}" />
                                    <ComboBox x:Name="IntervalUnitBox" Width="110" Margin="6,0,0,0" />
                                </WrapPanel>
                                <WrapPanel Margin="0,6,0,0">
                                    <TextBlock Text="Starting " VerticalAlignment="Center" />
                                    <DatePicker x:Name="StartDate" Width="165" />
                                    <TextBlock Text=" at " VerticalAlignment="Center" />
                                    <TextBox x:Name="StartTime" Width="140" VerticalContentAlignment="Center" />
                                    <Button Content="Now" MinWidth="0" Margin="6,0,0,0" Click="StartNow_Click"
                                            ToolTip="Set the start to today and the current time" />
                                </WrapPanel>
                                <TextBlock Text="When it's marked done, the next time comes up:" Margin="0,8,0,2" />
                                <RadioButton x:Name="FromDoneRadio" GroupName="Restart" Margin="12,2,0,0"
                                             Content="N after it's marked _done (the timer restarts then)" />
                                <RadioButton x:Name="OnScheduleRadio" GroupName="Restart" Margin="12,2,0,0"
                                             Content="on the _original schedule, as soon as the time comes up" />
                            </StackPanel>
                        </Border>

                        <RadioButton x:Name="WeeklyRadio" GroupName="Schedule" Style="{StaticResource PaneRadio}"
                                     Content="On these days of the _week" />
                        <Border Style="{StaticResource NestedPane}">
                            <StackPanel Style="{StaticResource PaneBody}"
                                        IsEnabled="{Binding IsChecked, ElementName=WeeklyRadio}">
                                <WrapPanel x:Name="DayBoxes" />
                                <WrapPanel Margin="0,6,0,0">
                                    <TextBlock Text="At " VerticalAlignment="Center" />
                                    <TextBox x:Name="WeeklyTime" Width="140" VerticalContentAlignment="Center" />
                                </WrapPanel>
                                <WrapPanel Margin="0,6,0,0">
                                    <TextBlock Text="Every " VerticalAlignment="Center" />
                                    <TextBox x:Name="WeekIntervalBox" Style="{StaticResource Small}" />
                                    <TextBlock Text=" weeks, starting the week of " VerticalAlignment="Center" />
                                    <DatePicker x:Name="WeeksFromDate" Width="165" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                           Text="1: every week. 2: every other week, and so on." />
                            </StackPanel>
                        </Border>

                        <RadioButton x:Name="OnceRadio" GroupName="Schedule" Style="{StaticResource PaneRadio}"
                                     Content="O_nce" />
                        <Border Style="{StaticResource NestedPane}">
                            <WrapPanel Style="{StaticResource PaneBody}"
                                       IsEnabled="{Binding IsChecked, ElementName=OnceRadio}">
                                <TextBlock Text="On " VerticalAlignment="Center" />
                                <DatePicker x:Name="OnceDate" Width="165" />
                                <TextBlock Text=" at " VerticalAlignment="Center" />
                                <TextBox x:Name="OnceTime" Width="140" VerticalContentAlignment="Center" />
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <RadioButton x:Name="CountdownRadio" GroupName="Top" Style="{StaticResource PaneRadio}"
                             Content="_Countdown timer (one-shot)" Margin="0,4,0,3" />
                <Border Style="{StaticResource Pane}">
                    <StackPanel Style="{StaticResource PaneBody}"
                                IsEnabled="{Binding IsChecked, ElementName=CountdownRadio}">
                        <WrapPanel>
                            <TextBlock Text="Sound an alarm after " VerticalAlignment="Center" />
                            <TextBox x:Name="CountdownHours" Style="{StaticResource Small}" />
                            <TextBlock Text=" h " VerticalAlignment="Center" />
                            <TextBox x:Name="CountdownMinutes" Style="{StaticResource Small}" />
                            <TextBlock Text=" min " VerticalAlignment="Center" />
                            <TextBox x:Name="CountdownSeconds" Style="{StaticResource Small}" />
                            <TextBlock Text=" s" VerticalAlignment="Center" />
                        </WrapPanel>
                        <TextBlock x:Name="CountdownStatus" Margin="0,6,0,0" Style="{StaticResource Hint}" />
                        <CheckBox x:Name="RestartCountdown" Margin="0,4,0,0"
                                  Content="Start the countdown again from now when I save" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Pane}">
                    <StackPanel>
                        <TextBlock Text="If the alarm is closed without being marked done, remind again after:" />
                        <WrapPanel Margin="0,4,0,0">
                            <TextBox x:Name="ReminderHours" Style="{StaticResource Small}" />
                            <TextBlock Text=" h " VerticalAlignment="Center" />
                            <TextBox x:Name="ReminderMinutes" Style="{StaticResource Small}" />
                            <TextBlock Text=" min" VerticalAlignment="Center" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                   Text="0 h 0 min: no more reminders until the next time it comes up." />
                        <WrapPanel Margin="0,10,0,0">
                            <TextBlock Text="Sound: " VerticalAlignment="Center" />
                            <Button x:Name="SoundButton" Click="Sound_Click" MinWidth="180"
                                    HorizontalContentAlignment="Left" ToolTip="Choose the sound for this task" />
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock Text="Play it " VerticalAlignment="Center" />
                            <ComboBox x:Name="SoundModeBox" MinWidth="330" />
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock Text="Volume: " VerticalAlignment="Center" />
                            <ComboBox x:Name="VolumeBox" MinWidth="180" />
                            <ComboBox x:Name="FadeInBox" MinWidth="230" Margin="8,0,0,0" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                   Text="Of the system volume. A fade-in starts quietly and grows to this." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <!-- Below the scrolling part, so an error is seen when Save finds one. -->
        <TextBlock Grid.Row="1" x:Name="ErrorText" Style="{StaticResource Error}" Margin="14,8,14,0" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,6,14,12">
            <!-- No IsDefault button: Enter never saves; only a click (or Alt+S) does. -->
            <Button Content="_Save" Click="Save_Click" Style="{StaticResource Primary}" />
            <!-- IsCancel makes Esc press it; the window isn't modal, so Click closes it. -->
            <Button Content="Cancel" IsCancel="True" Margin="8,0,0,0" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
