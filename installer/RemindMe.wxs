<?xml version="1.0" encoding="UTF-8"?>
<!-- The Windows installer (S9). build-msi.ps1 builds it; see design.md -> Releases. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <!-- Supplied by build-msi.ps1 with -d; the defaults let the file build on its own. -->
  <?ifndef Version?>    <?define Version    = "0.1.0.0"?> <?endif?>
  <?ifndef PublishDir?> <?define PublishDir = "publish"?> <?endif?>

  <Package Name="RemindMe"
           Manufacturer="inhahe"
           Version="$(var.Version)"
           UpgradeCode="5DB03741-ADF3-4FC8-A25B-E1AF64175702"
           Scope="perMachine"
           Compressed="yes">

    <SummaryInformation Description="RemindMe: reminders and alarms, kept in sync between your devices" />

    <!-- The UpgradeCode never changes: Windows uses it with the version to replace an
         older install. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of RemindMe is already installed. Setup will now exit." />

    <MediaTemplate EmbedCab="yes" />

    <!-- The small .ico, not the exe: an icon taken from the exe embeds it a second time. -->
    <Icon Id="AppIcon" SourceFile="app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="RemindMe" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the previous version went. -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallDir" Root="HKLM" Key="SOFTWARE\RemindMe" Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="Main" Title="RemindMe" Level="1">
      <ComponentGroupRef Id="AppComponents" />
    </Feature>

    <!-- Before an upgrade replaces the exe, the running copy (the installing user's) is
         asked to exit; "RemindMe.exe -exit" waits until it has. Ringing alarms
         aren't dismissed by it: they ring again when the new version starts. -->
    <CustomAction Id="StopRunningApp" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]RemindMe.exe&quot; --exit"
                  Execute="immediate" Return="ignore" Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="StopRunningApp" Before="InstallValidate" Condition="WIX_UPGRADE_DETECTED" />
    </InstallExecuteSequence>

    <!-- "Launch RemindMe now" on the last page: alarms only ring while it runs.
         As the installing user (its settings and autostart are per-user), and without
         waiting for it. -->
    <CustomAction Id="LaunchApp" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]RemindMe.exe&quot;"
                  Execute="immediate" Return="asyncNoWait" Impersonate="yes" />

    <!-- Welcome, the license (MIT, as in LICENSE), the install folder, then installing. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch RemindMe now" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApp"
               Order="10" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
  </Package>

  <Fragment>
    <ComponentGroup Id="AppComponents">

      <!-- The self-contained single-file exe. Sync listens on the network, so the
           firewall lets it in on private and domain networks (instead of asking on first
           run); not on public ones. Uninstalling removes the rules. -->
      <Component Id="MainExecutable" Directory="INSTALLFOLDER" Guid="*">
        <File Id="AppExe" Source="$(var.PublishDir)\RemindMe.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="RemindMe"
                    WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" Advertise="yes" />
          <fw:FirewallException Id="FirewallPrivate" Name="RemindMe (sync)" Scope="any" Profile="private" />
          <fw:FirewallException Id="FirewallDomain" Name="RemindMe (sync, domain)" Scope="any" Profile="domain" />
        </File>
      </Component>

      <!-- Its GUID goes with its key path: a different registry key needs a new GUID. -->
      <Component Id="RememberInstallDir" Directory="INSTALLFOLDER" Guid="D520221D-D77A-4BFA-9868-9B0D931BD054">
        <RegistryValue Root="HKLM" Key="SOFTWARE\RemindMe" Name="InstallDir" Type="string"
                       Value="[INSTALLFOLDER]" KeyPath="yes" />
      </Component>

    </ComponentGroup>
  </Fragment>
</Wix>
