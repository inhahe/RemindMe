<?xml version="1.0" encoding="UTF-8"?>
<!-- The Windows installer (S9). build-msi.ps1 builds it; see design.md -> Releases. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- Supplied by build-msi.ps1 with -d. Built without it, these defaults serve, and
       License.rtf (below) must be put on a bind path: the script writes it from LICENSE. -->
  <?ifndef Version?>    <?define Version    = "0.1.0.0"?> <?endif?>
  <?ifndef PublishDir?> <?define PublishDir = "publish"?> <?endif?>

  <Package Name="RemindMe"
           Manufacturer="inhahe"
           Version="$(var.Version)"
           UpgradeCode="5DB03741-ADF3-4FC8-A25B-E1AF64175702"
           Scope="perMachine"
           Compressed="yes">

    <SummaryInformation Description="RemindMe: reminders and alarms, kept in sync between your devices" />

    <!-- The UpgradeCode never changes: Windows uses it with the version to replace an
         older install. The new version is installed over the old one, which is then
         removed, all in one transaction: an upgrade that fails or is cancelled puts the old
         one back (and RestartAppOnRollback starts it again), rather than leaving neither.
         This needs the component rules kept: a component's resources never change under
         its GUID (a new resource goes in a new component). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" Schedule="afterInstallExecute"
                  DowngradeErrorMessage="A newer version of RemindMe is already installed. Setup will now exit." />
    <!-- Installed over the old version, a file is otherwise only replaced by a higher file
         version: a package of the same version (a rebuild), or one older only in the fourth
         part (which Windows counts as the same version), would keep the old exe. "a": every
         file is the package's own. -->
    <Property Id="REINSTALLMODE" Value="amus" />

    <MediaTemplate EmbedCab="yes" />

    <!-- The small .ico, not the exe: an icon taken from the exe embeds it a second time. -->
    <Icon Id="AppIcon" SourceFile="app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="RemindMe" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the previous version went. -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallDir" Root="HKLM" Key="SOFTWARE\RemindMe" Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="Main" Title="RemindMe" Level="1">
      <ComponentGroupRef Id="AppComponents" />
    </Feature>

    <!-- Before an upgrade replaces the exe, the running copy (the installing user's) is
         asked to exit; "RemindMe.exe -exit" waits until it has. Ringing alarms
         aren't dismissed by it: they ring again when the new version starts. -->
    <CustomAction Id="StopRunningApp" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]RemindMe.exe&quot; --exit"
                  Execute="immediate" Return="ignore" Impersonate="yes" />
    <!-- Whether a copy runs when the upgrade begins (any RemindMe.exe, found by name):
         if so, it is started again afterwards, rather than left stopped, alarms and all, until
         the next sign-in. Detection only: StopRunningApp is what stops it, gracefully. -->
    <util:CloseApplication Id="DetectRunningApp" Target="RemindMe.exe" Property="REMINDME_RUNNING"
                           CloseMessage="no" EndSessionMessage="no" PromptToContinue="no" RebootPrompt="no" />
    <!-- That finds a copy of any user's, so the restart also needs the installing user to
         have used RemindMe (its settings in their profile): another user's copy alone
         doesn't start it for someone who never has. -->
    <Property Id="REMINDME_USED" Secure="yes">
      <DirectorySearch Id="UserDataDir" Path="[LocalAppDataFolder]RemindMe" Depth="0">
        <FileSearch Id="UserSettings" Name="settings.json" />
      </DirectorySearch>
    </Property>

    <!-- After an upgrade, if a copy was running: started again in the tray, as at sign-in,
         whether or not the last page's box is ticked, or there is no last page (msiexec
         /passive or /qn). Through the shell, so with the user's own rights even when the
         install runs elevated (from an elevated prompt): a copy started elevated couldn't
         be reached by the user's later launches. The shell runs a target without arguments,
         hence the shortcut, which carries the minimized start. -->
    <SetProperty Id="WixUnelevatedShellExecTarget" Value="[INSTALLFOLDER]RemindMe (tray).lnk"
                 Before="RestartApp" Sequence="execute" />
    <CustomAction Id="RestartApp" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixUnelevatedShellExec"
                  Execute="immediate" Return="ignore" />
    <!-- An upgrade that fails or is cancelled after the running copy was stopped puts the
         old version back (MajorUpgrade, above); this starts it again. First in the script,
         so last in a rollback, once the old files are back. A rollback action can't use the
         shell, so it runs with the installing user's token, as StopRunningApp does. -->
    <CustomAction Id="RestartAppOnRollback" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]RemindMe.exe&quot; --minimized"
                  Execute="rollback" Return="asyncNoWait" Impersonate="yes" />
    <InstallExecuteSequence>
      <!-- The detection (DetectRunningApp) has to come before StopRunningApp; the extension
           would place it just before InstallFiles. Asked only to detect, it schedules no
           deferred part, so it may run before InstallInitialize. -->
      <Custom Action="override Wix4CloseApplications_$(sys.BUILDARCHSHORT)" Before="StopRunningApp" />
      <Custom Action="StopRunningApp" Before="InstallValidate" Condition="WIX_UPGRADE_DETECTED" />
      <Custom Action="RestartAppOnRollback" After="InstallInitialize"
              Condition="WIX_UPGRADE_DETECTED AND NOT REMOVE AND REMINDME_RUNNING AND REMINDME_USED" />
      <Custom Action="RestartApp" After="InstallFinalize"
              Condition="WIX_UPGRADE_DETECTED AND NOT REMOVE AND REMINDME_RUNNING AND REMINDME_USED" />
    </InstallExecuteSequence>

    <!-- "Launch RemindMe now" on the last page: alarms only ring while it runs. Through the
         shell too, as the user and not elevated (its settings and autostart are per-user).
         When RestartApp has started it already, this brings its window forward. -->
    <CustomAction Id="LaunchApp" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixUnelevatedShellExec"
                  Execute="immediate" Return="ignore" />

    <!-- Welcome, the license, the install folder, then installing. build-msi.ps1 writes
         License.rtf from LICENSE into its work folder, a bind path. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch RemindMe now" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Property="WixUnelevatedShellExecTarget" Value="[INSTALLFOLDER]RemindMe.exe"
               Order="9" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApp"
               Order="10" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
  </Package>

  <Fragment>
    <ComponentGroup Id="AppComponents">

      <!-- The self-contained single-file exe. Sync listens on the network, so the
           firewall lets it in on private and domain networks (instead of asking on first
           run); not on public ones. Uninstalling removes the rules. -->
      <Component Id="MainExecutable" Directory="INSTALLFOLDER" Guid="*">
        <File Id="AppExe" Source="$(var.PublishDir)\RemindMe.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="RemindMe"
                    WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" Advertise="yes" />
          <fw:FirewallException Id="FirewallPrivate" Name="RemindMe (sync)" Scope="any" Profile="private" />
          <fw:FirewallException Id="FirewallDomain" Name="RemindMe (sync, domain)" Scope="any" Profile="domain" />
        </File>
      </Component>

      <!-- What RestartApp starts: the shell runs a target without arguments. A component of
           its own, as a resource new since 0.1.2.0 (the component rules, above). -->
      <Component Id="TrayShortcut" Directory="INSTALLFOLDER" Guid="7E4B2C19-3A85-4F60-B1D7-95C2E8A04F36">
        <Shortcut Id="TrayShortcut" Name="RemindMe (tray)" Target="[#AppExe]" Arguments="--minimized"
                  WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\RemindMe" Name="TrayShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- Its GUID goes with its key path: a different registry key needs a new GUID. -->
      <Component Id="RememberInstallDir" Directory="INSTALLFOLDER" Guid="D520221D-D77A-4BFA-9868-9B0D931BD054">
        <RegistryValue Root="HKLM" Key="SOFTWARE\RemindMe" Name="InstallDir" Type="string"
                       Value="[INSTALLFOLDER]" KeyPath="yes" />
      </Component>

    </ComponentGroup>
  </Fragment>
</Wix>
